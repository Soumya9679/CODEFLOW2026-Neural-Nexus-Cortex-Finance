# Workspace root gitignore

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDEs and Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.patch
*.diff

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / package manager lock files or temp files (if at root)
node_modules/
dist/
build/
temp/
tmp/
