# JWT Token configuration (Used to sign user sessions)
JWT_SECRET=your_custom_secure_jwt_secret_key_here

# SQLite database path (default is empty, which falls back to cortex_finance.db)
DATABASE_URL=

# Gemini API credentials (choose one, code checks for GEMINI_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio

# Pinecone Vector DB credentials (optional: falls back to local FAISS store if empty)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=cortex-finance

# Hugging Face Inference API Token (Required for cloud-based embeddings)
HF_API_TOKEN=your_huggingface_api_token_here

# Celery and Redis configurations
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

